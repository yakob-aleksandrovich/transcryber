# Application config has moved to config.yaml (copy config.example.yaml).
# This .env is now ONLY for the bundled MySQL container's own credentials,
# which the mysql:8 image reads from the environment.
#
# If you use SQLite or an external MySQL (set in config.yaml), you don't need
# this file at all.

# Password for the bundled MySQL's app user. This MUST match the password in the
# database_url in config.yaml.
MYSQL_PASSWORD=transcryber
MYSQL_ROOT_PASSWORD=change-me-root
